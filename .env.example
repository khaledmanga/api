# Copy to .env and set the connection URL for the database to migrate.
# URL-encode special characters in the username or password.
# Optional application overrides. Uncomment and set values as needed.
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_NAME=your-database-name
# DB_TLS=false
# DB_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PASSWORD_COST=12
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0
# REDIS_TLS=false
# REDIS_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
ATLAS_DB_URL=mysql://kyoani_user:userpassword@127.0.0.1:3306/kyoani_db
